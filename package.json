    "@tarojs/plugin-html": "^4.3.3",
    "@tarojs/plugin-http": "^4.3.3",
    "@tarojs/plugin-platform-h5": "4.3.3",
    "@tarojs/plugin-platform-weapp": "4.3.3",
    "@tarojs/react": "4.3.3",
    "@tarojs/runtime": "4.3.3",
    "@tarojs/shared": "4.3.3",
    "@tarojs/taro": "4.3.3",
    "axios": "^1.21.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.53.2",
    "radash": "^12.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpack-bundle-analyzer": "^5.4.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
