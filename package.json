    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "@stylistic/stylelint-plugin": "^6.0.1",
    "@tarojs/cli": "4.3.3",
    "@tarojs/plugin-generator": "4.3.3",
    "@tarojs/taro-loader": "4.3.3",
