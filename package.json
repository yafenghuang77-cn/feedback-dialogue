{
  "name": "feedback-dialogue",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "author": "",
  "scripts": {
    "build:h5": "pnpm typecheck && taro build --type h5",
    "build:weapp": "pnpm typecheck && taro build --type weapp",
    "check": "pnpm lint && pnpm lint:style && pnpm lint:md && pnpm format:check && pnpm typecheck",
    "commitlint": "commitlint",
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:md": "markdownlint-cli2 \"**/*.{md,markdown}\"",
    "lint:md:fix": "pnpm lint:md --fix",
    "lint:style": "stylelint \"**/*.{css,less}\" --max-warnings=0 --allow-empty-input",
    "lint:style:fix": "pnpm lint:style --fix",
    "lint:unused": "knip",
    "new": "taro new",
    "prepare": "husky",
    "test": "vitest run",
    "test:lint": "vitest run --project lint",
    "test:watch": "vitest watch",
    "typecheck": "tsc -b"
  },
  "browserslist": {
    "development": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "production": [
      "last 3 versions",
      "Android >= 4.1",
      "ios >= 8"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
